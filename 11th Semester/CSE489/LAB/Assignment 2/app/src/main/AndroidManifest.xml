<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to load the image from the internet (B. Image scale). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Assignment2"
        tools:targetApi="31">

        <!-- Drawer host: fragments for Broadcast Receiver, Image, Video, Audio. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Assignment2.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A.1  Second activity: takes the plain-text input (custom broadcast). -->
        <activity
            android:name=".broadcast.TextInputActivity"
            android:exported="false"
            android:label="@string/title_text_input"
            android:parentActivityName=".MainActivity" />

        <!-- A.1  Third activity: hosts the custom BroadcastReceiver. -->
        <activity
            android:name=".broadcast.CustomReceiverActivity"
            android:exported="false"
            android:label="@string/title_custom_receiver"
            android:parentActivityName=".broadcast.TextInputActivity" />

        <!-- A.2  Second activity: receives the system battery broadcast. -->
        <activity
            android:name=".broadcast.BatteryActivity"
            android:exported="false"
            android:label="@string/title_battery"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
